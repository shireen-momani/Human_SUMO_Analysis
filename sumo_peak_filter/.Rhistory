setwd("/Users/shireen/Library/CloudStorage/Dropbox/BBSRC_NLD_DTP_Studentship_Organised/Human_SUMO_Build/Manuscript/scripts_original/removing_sumo_fragment_peaks_mzML/")
library(mzR)
library(msdata)
# List all mzML files in folder
fileNames <- Sys.glob("*.mzML")
# Adjusted monoisotopic masses of fragment ions resulting from the fragmentation of the SUMO remnant QQTGG and pyro-QQTGG
DIlist <- c(472.22, 472.21, 415.2, 415.19, 358.17, 257.13,
257.12, 455.19, 455.18, 398.17, 398.16, 341.14,
240.1, 240.09)
for (fileName in fileNames) {
ms_fl <- openMSfile(fileName, backend = "pwiz")
# Extract spectra and headers
spectra_list <- spectra(ms_fl)
hdr <- header(ms_fl)
modified_spectra <- list()
modified_headers <- list()
# Process each spectrum
for (i in seq_len(nrow(hdr))) {
ms_level <- hdr[i, "msLevel"]
spectrum <- spectra_list[[i]]
if (ms_level == 2) {
mz_values <- round(spectrum[, 1], 2)  # Round m/z values to match DIlist
to_remove <- which(mz_values %in% DIlist)
if (length(to_remove) > 0) {
spectrum <- spectrum[-to_remove, , drop = FALSE]  # Remove unwanted peaks
# Update header
hdr[i, "peaksCount"] <- nrow(spectrum)
if (nrow(spectrum) > 0) {
hdr[i, "lowMZ"] <- min(spectrum[, 1])  # Minimum m/z
hdr[i, "highMZ"] <- max(spectrum[, 1])  # Maximum m/z
hdr[i, "basePeakIntensity"] <- max(spectrum[, 2])  # Highest intensity
hdr[i, "basePeakMZ"] <- spectrum[which.max(spectrum[, 2]), 1]  # m/z of highest intensity
} else {
# Handle empty spectrum case
hdr[i, "lowMZ"] <- 0
hdr[i, "highMZ"] <- 0
hdr[i, "basePeakIntensity"] <- 0
hdr[i, "basePeakMZ"] <- 0
}
}
}
# Store the processed spectrum and header
modified_spectra[[length(modified_spectra) + 1]] <- spectrum
modified_headers[[length(modified_headers) + 1]] <- hdr[i, ]
}
# Convert header list to dataframe
df_headers <- do.call(rbind, modified_headers)
# Create output directory if it doesn't exist
if (!dir.exists("output")) {
dir.create("output")
}
# Write to mzML file.
new_filename <- sub("\\.mzML$", "", fileName)
output <- file.path("output", paste0(new_filename, "_clean.mzML"))
writeMSData(object = modified_spectra, file = output, header = df_headers)
}
